<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>50PSoftware.GrammarModular.Czech</PackageId>
    <Version>1.0.0-preview.27</Version>
    <Authors>Vojtěch Pchálek</Authors>
    <Company>50PSoftware</Company>
    <Description>Czech morphologial generator for .NET</Description>
    <PackageTags>czech;nlp;morphology;linguistics</PackageTags>
    <RepositoryUrl>https://github.com/50PSoftware/GrammarModular</RepositoryUrl>
    
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" />
  </ItemGroup>

  <!--
    The lexicon is copied beside anything built in this repository — the tests and the CLI resolve it
    from their own output directory — but it is deliberately NOT packed.

    A dictionary and a morphology library change on different schedules: a word added on the server is
    not a reason to release a new version of this package, and a consumer should not have to wait for
    one. So the package carries the code and the deployment supplies the data, pointing at it with
    AddCzechGrammarServices(path) or the GRAMMAR_CZECH_LEXICON variable.

    What that costs, and how it is paid: the two can now drift apart, so SqliteValencyProvider checks
    schema_version when it opens the file and refuses a lexicon written for a schema it does not read.

    The Exists condition lets the repository bootstrap itself: Grammar.Czech.Lexicon.Tool builds the
    database and references this project to do it, so requiring the file here would mean the tool could
    never be built to produce it.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Data\Lexicon\grammar.czech.lexicon.db')">
    <Content Include="Data\Lexicon\grammar.czech.lexicon.db"
             Link="grammar.czech.lexicon.db"
             CopyToOutputDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

<ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
