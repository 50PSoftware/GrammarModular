<Project Sdk="MSTest.Sdk/3.6.4">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grammar.Czech\Grammar.Czech.csproj" />
    <!--<ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />-->

    <!-- For the embedded .sql files, so the schema variants can be compared against each other. -->
    <ProjectReference Include="..\Grammar.Czech.Lexicon.Tool\Grammar.Czech.Lexicon.Tool.csproj" />

    <!-- The client application: what it makes of a bare list of lemmas is behaviour like any other. -->
    <ProjectReference Include="..\Grammar.Czech.Cli\Grammar.Czech.Cli.csproj" />

    <!-- Generate-and-test candidate matching, tokenization and known-word filtering. -->
    <ProjectReference Include="..\Grammar.Czech.Analyzer\Grammar.Czech.Analyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.Analyzers" Version="4.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.1.0" />
  </ItemGroup>

</Project>
