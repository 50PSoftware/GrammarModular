<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Grammar.Czech.Lexicon.Tool</RootNamespace>

    <!-- A build utility, not something to publish. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />
    <ProjectReference Include="..\Grammar.Czech\Grammar.Czech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" />
    <EmbeddedResource Include="Data\*.sql" />
  </ItemGroup>

  <!--
    One file, named rather than globbed. It holds the server's half of the column map and the permitted
    values, and PhpSchemaParityTests reads it from the output directory to check it against
    LexiconSchema and the C# enums — two hand-maintained lists that nothing compares will drift.

    This was Php\**\*.php, which copied the entire PHP application into bin. Two reasons not to:
    nothing in the build has any use for the endpoint or the admin, and .env.php matches *.php, so a
    real configuration file with the API token and the database password in it was copied into the
    build output — and, because Content flows across a ProjectReference, into the test project's
    output as well. Both are git-ignored, so nothing would have reached a commit; but a secret in
    three places instead of one outlives its rotation and travels with any copy of bin.
  -->
  <ItemGroup>
    <Content Include="Php\schema-tables.php" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
