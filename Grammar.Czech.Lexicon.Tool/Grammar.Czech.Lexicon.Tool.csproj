<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Grammar.Czech.Lexicon.Tool</RootNamespace>

    <!-- A build utility, not something to publish. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />
    <ProjectReference Include="..\Grammar.Czech\Grammar.Czech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" />
    <EmbeddedResource Include="Data\*.sql" />
  </ItemGroup>

  <!--
    The PHP is the server half of the same contract and is not compiled into anything, but it is copied
    to the output so the tests can read it: its column map has to agree with LexiconSchema, and two
    hand-maintained lists that nothing compares will drift.
  -->
  <ItemGroup>
    <Content Include="Php\**\*.php" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
