<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Grammar.Czech.Lexicon.Tool</RootNamespace>

    <!--
      Balí se jako .NET tool: `dotnet tool install` a pak `slovnik pull` odkudkoli.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slovnik</ToolCommandName>
    <PackageId>50PSoftware.GrammarModular.Czech.LexiconTool</PackageId>
    <Version>1.0.0-preview.36</Version>
    <Authors>Vojtěch Pchálek</Authors>
    <Company>50PSoftware</Company>
    <Description>Správa slovníku pro Grammar Modular — stahování, kontrola a export.</Description>
    <PackageTags>czech;nlp;lexicon;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />
    <ProjectReference Include="..\Grammar.Czech\Grammar.Czech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" />
    <EmbeddedResource Include="Data\*.sql" />
  </ItemGroup>

  <!--
    The server's half of the column map, embedded rather than copied beside the assembly. Only
    PhpSchemaParityTests reads it, and it needs the contents, not a file — nothing in a .NET build
    output has any use for PHP source.

    This was Content with a Php\**\*.php glob, which copied the whole PHP application into bin. The
    part that made it worth undoing rather than tidying: .env.php matches *.php, so a real
    configuration file with the API token and the database password in it was copied into the build
    output, and — because Content flows across a ProjectReference — into the test project's output as
    well. Embedding takes one named file and cannot pick up anything else.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Php\schema-tables.php" />
  </ItemGroup>

  <!--
    Slovník ven z balíčku nástroje.

    Grammar.Czech ho má jako Content s CopyToOutputDirectory, aby ho měly po ruce testy a CLI, a přes
    ProjectReference se zkopíruje i sem. Pack="false" tam brání jen tomu, aby šel do balíčku
    Grammar.Czech — do publish výstupu tohohle projektu se dostane stejně, a `dotnet tool` balí právě
    ten. Ověřeno rozbalením nupkg, ne přečtením konfigurace: byl tam.

    Vadí to dvakrát. Nainstalovaný nástroj by nesl slovník, který nikdy nečte — cestu k němu bere
    z nastavení, ne z místa, kde je nainstalovaný — a hlavně by ho rozdával každému, kdo si nástroj
    nainstaluje. To je přesně to, čemu se vyhýbá i balíček knihovny.
  -->
  <Target Name="DropLexiconFromToolPackage" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'grammar.czech.lexicon.db'" />
    </ItemGroup>
  </Target>

</Project>
