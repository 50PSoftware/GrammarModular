<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Grammar.Czech.Lexicon.Tool</RootNamespace>

    <!-- A build utility, not something to publish. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />
    <ProjectReference Include="..\Grammar.Czech\Grammar.Czech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\*.sql" />
    <EmbeddedResource Include="Data\*.sql" />
  </ItemGroup>

  <!--
    The server's half of the column map, embedded rather than copied beside the assembly. Only
    PhpSchemaParityTests reads it, and it needs the contents, not a file — nothing in a .NET build
    output has any use for PHP source.

    This was Content with a Php\**\*.php glob, which copied the whole PHP application into bin. The
    part that made it worth undoing rather than tidying: .env.php matches *.php, so a real
    configuration file with the API token and the database password in it was copied into the build
    output, and — because Content flows across a ProjectReference — into the test project's output as
    well. Embedding takes one named file and cannot pick up anything else.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Php\schema-tables.php" />
  </ItemGroup>

</Project>
