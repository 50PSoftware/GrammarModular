# Apache configuration for the directory that holds the whole application — normally the document
# root itself, which on shared hosting is where it has to be: www/ cannot be moved and the secrets
# therefore have nowhere else to go. A subdirectory of the root works too, and nothing here changes.
#
#   .        the admin      (index.php)
#   api/     the API        (api/index.php)
#
# The admin addresses its pages by path — /hesla, /heslo/42, /ramec/7 — so everything that is not the
# API and not the stylesheet is handed to index.php.
#
# The rule names what to leave alone rather than testing whether the target exists. The tempting form,
# RewriteCond %{REQUEST_FILENAME} !-f, skips .env precisely because .env is a real file, and from then
# on the server hands it out in the clear with nothing to show anything changed. An allowlist has no
# such edge: a file that is not on it is routed to PHP whether or not it exists on disk.
#
# What remains besides the rewrite is denies and one header fix.
#
# nginx ignores .htaccess entirely. There, put this in the server block:
#
#   location ~ /\. { deny all; return 404; }
#   location ~ ^/(env|schema-tables)\.php$ { deny all; return 404; }
#   location ^~ /admin/ { deny all; return 404; }
#   location = /style.css { }
#   location ^~ /api/ { }
#   location / { try_files /index.php =404; }
#
# Serving the admin from a subdirectory: nothing here needs changing, but PHP cannot always work out
# the prefix on its own. If pages load and the stylesheet does not, set LEXICON_ADMIN_BASE_PATH in
# .env.php — see the note there.

# ─────────────────────────────────────────────────────────────────────────────
# Denies
# ─────────────────────────────────────────────────────────────────────────────
#
# Require directives, not rewrites: they run in the authorization phase and hold whether or not
# mod_rewrite is loaded.

# Every dotfile: .env.php, .env.php.example, .htaccess itself.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# The shared includes. Only ever pulled in from the filesystem, never requested over HTTP.
#
# This cannot be a blanket deny on *.php — .htaccess applies to subdirectories, so that would take
# index.php and api/index.php with it and 403 everything.
<FilesMatch "^(env|schema-tables)\.php$">
    Require all denied
</FilesMatch>

# Apache 2.2 fallback, harmless under 2.4.
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.|^(env|schema-tables)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# The admin's internals live in admin/ and are denied wholesale by admin/.htaccess. Only index.php
# and style.css, both here in the root, are meant to be served.

# A directory listing would name the files even where fetching them is refused.
Options -Indexes

# ─────────────────────────────────────────────────────────────────────────────
# Authorization header and routing
# ─────────────────────────────────────────────────────────────────────────────
#
# Apache with CGI or FPM drops the Authorization header before PHP sees it, so every API request would
# arrive unauthenticated and answer 401 to a correct token.

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Everything below is matched against the path relative to the directory holding this file, never
    # against REQUEST_URI, and there is deliberately no RewriteBase. Both of those are what let the
    # whole directory be dropped anywhere — the document root or /czlex under it — and behave the same.
    #
    # Anchoring on REQUEST_URI does not survive the move. Under /czlex the request for the stylesheet
    # arrives as /czlex/style.css, an exclusion written ^/style\.css$ stops matching, and the front
    # controller swallows the request and answers it with HTML. The same goes for the API, which is
    # the worse half of it: the pull client would be handed a login page instead of JSON.
    #
    # A relative substitution has the per-directory prefix put back on it by mod_rewrite, so
    # `index.php` reaches this directory's index.php and not one at the server root. RewriteBase /
    # would override exactly that.

    # What the server hands out itself. index.php is listed because per-directory rewriting runs the
    # ruleset again on the rewritten path, and without stopping here the second pass would match too.
    RewriteRule ^(index\.php|style\.css)$ - [L]

    # The API keeps its own directory and its own index.php, untouched by any of this.
    RewriteRule ^api(/|$) - [L]

    # Everything else is a page of the admin.
    RewriteRule ^ index.php [L]
</IfModule>

# Without mod_rewrite there is no path to route on. index.php then reads the page from ?_path=, so the
# admin still works — one link deeper than it should be, but it works.
