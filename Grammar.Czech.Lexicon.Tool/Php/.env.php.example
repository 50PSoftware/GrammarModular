<?php

declare(strict_types=1);

/**
 * Grammar.Czech lexicon API — configuration template, PHP form.
 *
 * Copy to .env.php beside this file and fill in. The real file is git-ignored and must stay that way.
 *
 *   cp .env.php.example .env.php
 *
 * Use this rather than .env whenever the file has to live inside the document root — which on shared
 * hosting is always, because www/ cannot be moved. Requested over HTTP this file is executed and
 * returns nothing to the caller, so it leaks nothing even with no .htaccess, with AllowOverride off,
 * or on nginx. A plain .env in the same place is served as text to anyone who asks for it.
 *
 * The real environment still wins over this file, so a single value can be overridden with env[NAME]
 * in an FPM pool without editing anything here.
 */

return [
    // The charset is not optional: without it the connection can negotiate latin1 and every Czech
    // diacritic arrives mangled, silently. On shared hosting the host is not localhost — take it
    // from the control panel.
    'LEXICON_MYSQL_DSN' => 'mysql:host=localhost;dbname=d123456;charset=utf8mb4',

    'LEXICON_MYSQL_USER' => 'a123456',
    'LEXICON_MYSQL_PASSWORD' => '',

    // The bearer token the pull client presents is not configured here at all — it is per person,
    // minted from the admin's "Tokeny" page once signed in, and checked against the api_token table
    // (see admin/schema/api_token.mysql.sql) rather than against a value in this file.

    // The website's own database, read-only, so the admin can check an email and password against the
    // account that already exists there. A MySQL user with SELECT only on `user` is enough — this
    // connection never writes.
    'LEXICON_WEB_MYSQL_DSN' => 'mysql:host=localhost;dbname=d123456_web;charset=utf8mb4',
    'LEXICON_WEB_MYSQL_USER' => 'a123456',
    'LEXICON_WEB_MYSQL_PASSWORD' => '',

    // The role a website account's `roles` JSON must contain to sign in here. Whoever administers the
    // dictionary needs this role on their website account; everyone else's sign-in is refused even with
    // a correct password. Leave empty to keep the admin shut to everybody.
    'LEXICON_ADMIN_REQUIRED_ROLE' => '',

    // The additional role required for the "/export" download — the whole dictionary as one SQL dump,
    // including anything unpublished. Signing in does not imply this; a signed-in account without this
    // role gets a 403 on the route and no "Export" link in the nav. Leave empty to keep it shut to
    // everybody, same as LEXICON_ADMIN_REQUIRED_ROLE above.
    'LEXICON_ADMIN_EXPORT_ROLE' => '',

    // Where the admin sits in the site. Empty means work it out, which is right almost everywhere:
    // it is read from SCRIPT_NAME and then checked against the address the request actually came in
    // on, so a hosting that reports the path from the account root rather than from the document root
    // no longer misleads it.
    //
    // Set it when the addresses still come out wrong. The giveaway is that pages load but the
    // stylesheet does not — a page can be redirected to, a stylesheet cannot.
    //
    //   '/czlex'   served at https://example.cz/czlex/prihlaseni
    //   '/'        served at the root of its own (sub)domain, and stop guessing
    //
    // Leading slash, no trailing one. The API is not addressed through this — the pull client is
    // given the whole URL in LEXICON_API_URL.
    'LEXICON_ADMIN_BASE_PATH' => '',
];
