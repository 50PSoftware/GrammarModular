<title>Slovník — administrace</title>
<link rel="stylesheet" href="<?= h($url->asset('style.css')) ?>">
</head>
<body>
<?php if ($signedIn): ?>
<header class="bar">
    <a class="brand" href="<?= h($url->entries()) ?>">Slovník</a>
