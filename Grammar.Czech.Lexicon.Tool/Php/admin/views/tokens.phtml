<?php

declare(strict_types=1);

defined('LEXICON_ADMIN') || exit('Tenhle soubor se nespouští přímo.');

/**
 * Osobní tokeny pro `lexikon.ps1 pull`.
 *
 * @var list<array{id: int, label: ?string, created_at: string, last_used_at: ?string}> $tokens
 * @var string|null $newToken
 * @var \Lexicon\Admin\View\Url $url
 * @var \Lexicon\Admin\View\FormHelper $form
 */
?>
<h1>Tokeny</h1>

<?php if ($newToken !== null): ?>
    <p class="msg ok">
        Nový token — opiš si ho teď, podruhé se neukáže:<br>
        <code><?= h($newToken) ?></code>
    </p>
<?php endif; ?>

<form method="post" action="<?= h($url->tokens()) ?>" class="card">
    <?= $form->csrf() ?>
    <label for="label">Popisek</label>
    <input type="text" id="label" name="label" placeholder="notebook, server pull…">
    <button type="submit">Vygenerovat token</button>
</form>

<div class="scroller">
<table>
    <thead>
    <tr>
        <th>Popisek</th>
        <th>Vytvořen</th>
        <th>Naposledy použit</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    <?php foreach ($tokens as $token): ?>
        <tr>
            <td><?= h($token['label'] ?? '—') ?></td>
            <td><?= h($token['created_at']) ?></td>
            <td><?= h($token['last_used_at'] ?? 'nikdy') ?></td>
            <td>
                <form method="post" action="<?= h($url->deleteToken($token['id'])) ?>">
                    <?= $form->csrf() ?>
                    <button type="submit" class="link">Smazat</button>
                </form>
            </td>
        </tr>
    <?php endforeach; ?>
    </tbody>
</table>
</div>
