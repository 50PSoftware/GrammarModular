# Grammar.Czech lexicon API — configuration template.
#
# Copy to .env beside this file and fill in. The .env is git-ignored and must stay that way; this
# template is the committed one and must never hold a real value.
#
#   cp .env.example .env
#
# Point the vhost at Php/api/, never at Php/ — the .env belongs above whatever the web server serves,
# or it is downloadable as plain text. env.php refuses to start if it can tell that has happened.
#
# The real environment wins over this file, so a deployment can override one value with env[NAME] in
# the PHP-FPM pool without editing anything here.

# PDO DSN. The charset is not optional: without it the connection can negotiate latin1 and every Czech
# diacritic arrives mangled, silently.
LEXICON_MYSQL_DSN=mysql:host=localhost;dbname=lexikon;charset=utf8mb4

LEXICON_MYSQL_USER=lexikon
LEXICON_MYSQL_PASSWORD=

# Shared bearer token the pull client presents. Generate it, do not invent it:
#
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# Constant-time comparison protects it from being guessed a character at a time; it does not make a
# short one safe. Empty means the API refuses to serve at all rather than serving openly.
LEXICON_API_TOKEN=
