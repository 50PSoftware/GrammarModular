# Grammar.Czech lexicon API — configuration template.
#
# Copy to .env beside this file and fill in. The .env is git-ignored and must stay that way; this
# template is the committed one and must never hold a real value.
#
#   cp .env.example .env
#
# Point the vhost at Php/api/, never at Php/ — the .env belongs above whatever the web server serves,
# or it is downloadable as plain text. env.php refuses to start if it can tell that has happened.
#
# On shared hosting the document root cannot be moved and this file has nowhere else to go. Two ways
# to proceed, and pick one on purpose:
#
#   * Use .env.php instead (see .env.php.example). It returns an array, so a request for it is
#     executed rather than read out, and it cannot leak whatever the server is configured to do.
#     This is the better answer.
#
#   * Keep this file, protect it with the shipped .htaccess, and set the switch at the bottom. Then
#     verify it, because that is the only way to know the .htaccess is honoured at all:
#
#       curl -i https://tvadomena.cz/.env      # must be 403 or 404, never the contents
#
# The real environment wins over this file, so a deployment can override one value with env[NAME] in
# the PHP-FPM pool without editing anything here.

# PDO DSN. The charset is not optional: without it the connection can negotiate latin1 and every Czech
# diacritic arrives mangled, silently.
LEXICON_MYSQL_DSN=mysql:host=localhost;dbname=lexikon;charset=utf8mb4

LEXICON_MYSQL_USER=lexikon
LEXICON_MYSQL_PASSWORD=

# Shared bearer token the pull client presents. Generate it, do not invent it:
#
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# Constant-time comparison protects it from being guessed a character at a time; it does not make a
# short one safe. Empty means the API refuses to serve at all rather than serving openly.
LEXICON_API_TOKEN=

# Login to the admin at /admin/. A hash, never the password itself, so a leaked copy of this file does
# not hand over a working login:
#
#   php -r "echo password_hash('tvoje-heslo', PASSWORD_DEFAULT), PHP_EOL;"
#
# Note that a bcrypt hash contains $ characters. They are safe here — nothing in this file is
# interpolated — but quote the value if you ever move it into a shell.
LEXICON_ADMIN_PASSWORD_HASH=

# Set to 1 to say "this file is inside the document root on purpose and is protected another way",
# which stops env.php refusing to start. Anything other than 1/true/yes/on leaves the guard standing,
# so a typo fails safe. Leave it out entirely when the file lives above the document root.
#LEXICON_ALLOW_ENV_IN_DOCROOT=1
